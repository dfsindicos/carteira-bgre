// Modelo da Carteira BGRE (1ª entrega: cadastro e avaliação trimestral do Score Card da Brookfield).
// Os itens do Score Card não são tabela: são fixos, em src/lib/scorecard.ts. NotaItem guarda só o código ("2.2.1").
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Administradora {
  id           String       @id @default(cuid())
  nome         String       @unique
  // E-mails que vão receber o pedido de evidências (2ª entrega), separados por vírgula ou linha.
  emails       String       @default("")
  // Código da administradora no cadastro mestre (Action Log, decisão do usuário de 2026-11-12); nulo = ainda não ligada.
  codigoMestre String?      @unique
  condominios  Condominio[]
  criadoEm     DateTime     @default(now())
}

model Condominio {
  id                     String         @id @default(cuid())
  nome                   String         @unique
  administradoraId       String
  administradora         Administradora @relation(fields: [administradoraId], references: [id])
  // Sem exclusão: quem sai da carteira fica inativo, e o histórico das avaliações continua.
  ativo                  Boolean        @default(true)
  // Primeiro trimestre avaliado pela BGRE; os anteriores ficam "fora do período" no mapa. Vazio = desde o início do mapa.
  avaliadoDesdeAno       Int?
  avaliadoDesdeTrimestre Int?
  avaliacoes             Avaliacao[]
  // Identificador do prédio no Flash Report ("torre-norte"): liga os dados da rotina ao cadastro.
  flashSlug              String?        @unique
  // Código do condomínio no cadastro mestre (Action Log, decisão do usuário de 2026-11-12); nulo = só existe aqui.
  codigoMestre           String?        @unique
  flashSemanas           FlashSemana[]
  demandas               Demanda[]
  criadoEm               DateTime       @default(now())

  @@index([administradoraId])
}

// A BGRE avalia a administradora e a própria DF (sindicância), cada uma com o seu Score Card (src/lib/scorecard.ts).
enum TipoAvaliacao {
  ADMINISTRADORA
  SINDICANCIA
}

enum StatusAvaliacao {
  RASCUNHO
  // Entregue à BGRE = passo 4 do checklist marcado: bloqueia a edição das notas até alguém desmarcar.
  ENTREGUE
}

model Avaliacao {
  id           String          @id @default(cuid())
  condominioId String
  condominio   Condominio      @relation(fields: [condominioId], references: [id])
  ano          Int
  trimestre    Int
  tipo         TipoAvaliacao   @default(ADMINISTRADORA)
  status       StatusAvaliacao @default(RASCUNHO)
  entregaAte   DateTime?       @db.Date
  // Checklist do trimestre (4 passos): quando e quem marcou. O passo 4 ("Enviada à BGRE") é o status ENTREGUE, com a
  // data em entregueEm.
  passo1Em     DateTime?
  passo1Por    String?
  passo2Em     DateTime?
  passo2Por    String?
  passo3Em     DateTime?
  passo3Por    String?
  entregueEm   DateTime?
  passo4Por    String?
  // Anotações de andamento ("Falta: SST de setembro (2.5)") e a nota estimada enquanto não há nota final.
  andamento    String[]        @default([])
  andamentoEm  DateTime?       @db.Date
  estimativa   Decimal?        @db.Decimal(5, 2)
  notas        NotaItem[]
  criadoEm     DateTime        @default(now())
  atualizadoEm DateTime        @updatedAt

  @@unique([condominioId, ano, trimestre, tipo])
  @@index([ano, trimestre])
}

model NotaItem {
  id          String    @id @default(cuid())
  avaliacaoId String
  avaliacao   Avaliacao @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  // Código do item do Score Card, como "2.2.1".
  item        String
  nota        Decimal?  @db.Decimal(5, 2)
  comentario  String    @default("")

  @@unique([avaliacaoId, item])
}

// Toda alteração feita pelas telas, com quem fez (e-mail da conta Microsoft) e quando.
model LogAlteracao {
  id         String   @id @default(cuid())
  entidade   String
  entidadeId String
  campo      String
  antes      String?
  depois     String?
  email      String
  em         DateTime @default(now())

  @@index([entidade, entidadeId])
}

// Flash Report semanal (pedido do usuário de 2026-10-26): um registro por prédio e semana (segunda-feira), no formato
// que a rotina extrai dos e-mails (src/lib/flash.ts). Gravar a mesma semana de novo substitui, não duplica.
model FlashSemana {
  id           String     @id @default(cuid())
  condominioId String
  condominio   Condominio @relation(fields: [condominioId], references: [id])
  semana       DateTime   @db.Date
  dados        Json
  atualizadoEm DateTime   @updatedAt

  @@unique([condominioId, semana])
}

// O resto do painel (prédios na ordem e nomes do relatório, semanas, consolidados, texto executivo): uma linha só, id "atual".
model FlashPainel {
  id           String   @id
  dados        Json
  atualizadoEm DateTime @updatedAt
}

// Modelo oficial da planilha da BGRE (.xlsx), um por tipo de avaliação, enviado pela tela Cadastro (pedido do usuário de
// 2026-10-27). Fica no banco porque o repositório é público e o arquivo é da Brookfield. Sem modelo, "Gerar planilha
// BGRE" usa o formato da DF.
model ModeloPlanilha {
  tipo       TipoAvaliacao @id
  nome       String
  arquivo    Bytes
  enviadoEm  DateTime      @updatedAt
  enviadoPor String
}

// ── Demandas da BGRE (decisões do usuário de 2026-11-03) ───────────────────────────────────────────────────────────
// Cada e-mail da BGRE que pede algo à DF vira uma demanda (substitui os cards "[BGRE]" do Planner). A Triagem
// Contratante grava por /api/integracao/demandas; a DF trabalha em /demandas. Sem ligação com o Score Card: o
// condomínio é só um campo para filtrar, e pode ficar vazio. Nada se apaga: arquiva com motivo.

enum Criticidade {
  CRITICA
  URGENTE
  ORDINARIA
  COMPLEXA
}

enum SituacaoDemanda {
  ABERTA
  EM_ANDAMENTO
  AGUARDANDO
  // Agendamento de reunião (pedido do usuário de 2026-11-04); conta como aberta.
  REUNIAO
  CONCLUIDA
  ARQUIVADA
}

enum AguardandoDemanda {
  DF
  BGRE
  ADMINISTRADORA
  LOCATARIO
  CORRETORA
  FORNECEDOR
}

// Unidade de um prazo do SLA: horas corridas, dias úteis ou prazo combinado com a BGRE (só na conclusão).
enum UnidadePrazo {
  HORAS
  DIAS_UTEIS
  COMBINADO
}

enum TipoMensagemDemanda {
  // Mensagem de fora da DF na conversa (BGRE, administradora…), ou o pedido registrado à mão.
  RECEBIDA
  // Mensagem enviada por alguém da DF na conversa (a primeira marca a 1ª resposta).
  ENVIADA_DF
  // Andamento registrado pela tela.
  NOTA
}

model Demanda {
  id                  String             @id @default(cuid())
  numero              Int                @unique @default(autoincrement())
  titulo              String
  remetenteNome       String             @default("")
  remetenteEmail      String             @default("")
  condominioId        String?
  condominio          Condominio?        @relation(fields: [condominioId], references: [id])
  // Demanda que envolve todos os condomínios BGRE (pedido do usuário de 2026-11-04); com ela, condominioId fica nulo.
  todaCarteira        Boolean            @default(false)
  criticidade         Criticidade        @default(ORDINARIA)
  // Envio do e-mail da BGRE (ou o horário informado no registro à mão): o relógio do SLA começa aqui.
  chegadaEm           DateTime
  // Prazo escrito no e-mail (prevalece sobre o SLA, se a configuração mandar) e o prazo combinado com a BGRE.
  prazoEmail          DateTime?          @db.Date
  prazoCombinado      DateTime?          @db.Date
  primeiraRespostaEm  DateTime?
  primeiraRespostaPor String?
  situacao            SituacaoDemanda    @default(ABERTA)
  aguardando          AguardandoDemanda?
  // Análise (pedido do usuário de 2026-11-04): o que a BGRE pediu (com a frase original), a ação concreta da DF e o
  // próximo passo. A Triagem sugere; quem edita pela tela manda.
  pedido              String?
  oQueFazer           String?
  proximoPasso        String?
  // E-mail ou nome de quem da DF cuida.
  responsavel         String             @default("")
  concluidaEm         DateTime?
  arquivadaEm         DateTime?
  motivoArquivo       String?
  // Conversas do Outlook ligadas a esta demanda (normalmente uma; a mesma mensagem vista noutra caixa com outro ID de
  // conversa acrescenta o dela). Vazio no registro à mão.
  conversas           String[]           @default([])
  webLink             String?
  // TRIAGEM (rotina), MANUAL (tela: telefone, reunião…) ou PLANNER (carga única dos cards [BGRE]).
  origem              String             @default("TRIAGEM")
  canal               String?
  origemPlanner       String?
  mensagens           MensagemDemanda[]
  criadoEm            DateTime           @default(now())
  atualizadoEm        DateTime           @updatedAt

  @@index([situacao])
  @@index([condominioId])
}

model MensagemDemanda {
  id                String              @id @default(cuid())
  demandaId         String
  demanda           Demanda             @relation(fields: [demandaId], references: [id])
  // Chave da mensagem no e-mail: a mesma mensagem que chega às três caixas entra uma vez só. Nulo nas notas.
  internetMessageId String?             @unique
  conversationId    String?
  tipo              TipoMensagemDemanda
  em                DateTime
  autorNome         String              @default("")
  autorEmail        String              @default("")
  assunto           String              @default("")
  texto             String
  caixa             String?
  webLink           String?
  criadoEm          DateTime            @default(now())

  @@index([demandaId, em])
}

// SLA das demandas, uma linha por criticidade, editável em /demandas/sla (padrão: o do Einstein). Linha que falta usa
// o padrão de src/lib/prazos-demandas.ts. Toda mudança grava LogAlteracao (entidade "ConfiguracaoSla").
model SlaDemanda {
  criticidade      Criticidade  @id
  respostaValor    Int
  respostaUnidade  UnidadePrazo
  conclusaoValor   Int
  conclusaoUnidade UnidadePrazo
  atualizadoEm     DateTime     @updatedAt
  atualizadoPor    String
}

// Opções do SLA (linha única, id "atual").
model OpcoesSlaDemanda {
  id                  String   @id
  contarFeriados      Boolean  @default(true)
  prazoEmailPrevalece Boolean  @default(true)
  atualizadoEm        DateTime @updatedAt
  atualizadoPor       String
}

// Cadastro mestre (decisão do usuário de 2026-11-12: "o mestre fica no Action Log"): cada leitura do Action Log, com o
// resumo do que mudou (ok) ou o erro (falha). Ver src/lib/mestre.ts.
model SincronizacaoMestre {
  id     String   @id @default(cuid())
  em     DateTime @default(now())
  ok     Boolean
  resumo Json
}
