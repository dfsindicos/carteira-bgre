# Copie para .env (nunca commite o .env). Nenhum valor aqui é segredo real.

# Banco de desenvolvimento (o docker compose usa o próprio; este serve para rodar o app fora do Docker)
DATABASE_URL="postgresql://app:app@localhost:5432/bgre"

# Banco usado SOMENTE pelos testes. O nome precisa terminar em _test: os testes apagam as tabelas.
DATABASE_URL_TESTE="postgresql://app:app@localhost:5432/bgre_test"

# URL pública do app
APP_URL="http://localhost:3000"

# Assinatura da sessão: mínimo de 32 caracteres (openssl rand -hex 32). Na VPS é gerado sozinho no servidor.
AUTH_SECRET="troque-por-um-segredo-longo-gerado-com-openssl-rand-hex-32"

# Login Microsoft da DF (registro "Carteira BGRE DF" no Entra ID). URI de redirecionamento: <APP_URL>/api/auth/callback/microsoft
MICROSOFT_TENANT_ID=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# Condomínios e administradoras de demonstração (nomes inventados): npm run db:seed com SEED_DEMO=true
SEED_DEMO="false"
